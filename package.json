{
  "name": "threadline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Threadline — Codex-first agent memory and coordination (FalkorDB Track 2)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-artifact.mjs",
    "pack:artifact": "npm pack ./dist/npm",
    "clean": "tsc -b --clean",
    "setup": "npm run build && node dist/npm/dist/cli/index.js init",
    "serve": "node dist/npm/dist/cli/index.js serve",
    "status": "node dist/npm/dist/cli/index.js status"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@11.4.1"
}
