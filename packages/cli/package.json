{
  "name": "@threadline/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Threadline terminal client \u2014 command entry point and plain Ink interface",
  "license": "UNLICENSED",
  "bin": {
    "threadline": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc -b",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@threadline/shared": "0.0.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
