# Threadline local development configuration — copy to `.env` and edit.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Nothing here is a
# production credential: these are throwaway local development values.
#
# This one file configures both sides of local development: Docker Compose
# reads it when publishing ports and creating the database, and the backend
# reads it to connect to them. `THREADLINE_PG_PORT` is the host port Compose
# publishes and the port the backend connects to, so the two cannot drift.

# --- Data services, published on loopback ---
# Offsets from 5432/6379 so an unrelated local database is not clobbered.
THREADLINE_PG_PORT=55432
THREADLINE_FALKORDB_PORT=56379

# --- PostgreSQL (consumed by the backend; never by the terminal client) ---
THREADLINE_PG_HOST=127.0.0.1
THREADLINE_PG_DATABASE=threadline
THREADLINE_PG_USER=threadline_app
# Replace this before first use. The repository stores no password.
THREADLINE_PG_PASSWORD=replace-with-a-local-app-password
THREADLINE_PG_APPLICATION_ROLE=threadline_app
THREADLINE_PG_MIGRATION_USER=threadline_owner
THREADLINE_PG_MIGRATION_PASSWORD=replace-with-a-different-local-owner-password
THREADLINE_PG_SSL=disable

# --- FalkorDB (consumed by the backend; never by the terminal client) ---
THREADLINE_FALKORDB_HOST=127.0.0.1
THREADLINE_FALKORDB_USERNAME=
THREADLINE_FALKORDB_PASSWORD=

# --- Backend behaviour ---
# `unconfigured` keeps the M00 development-only surface working with no store.
# `required` makes the backend refuse to admit work it cannot record durably.
# It never falls back to an in-memory graph.
THREADLINE_STORAGE_MODE=required

# AOF keeps graph authority across an abrupt restart. `appendfsync always` is
# the correctness-first setting chosen for this small demo; its cost has not
# been measured.
THREADLINE_FALKORDB_APPENDONLY=yes
THREADLINE_FALKORDB_APPENDFSYNC=always

# --- Model provider ---
# Keep unset until explicitly choosing a paid model. Only the backend reads these.
# Configuration, backend startup and run:prepare never perform inference.
# Select one provider; only its corresponding key is read. No automatic fallback.
# Prefer provider:setup or /connect; saved selection overrides these legacy values.
THREADLINE_PROVIDER=openai
THREADLINE_OPENAI_API_KEY=
THREADLINE_ANTHROPIC_API_KEY=
THREADLINE_OPENROUTER_API_KEY=
MODEL_OPENCODE_API_KEY=
THREADLINE_PROVIDER_API_KEY=
THREADLINE_PROVIDER_MODEL=
# openai defaults to responses; opencode-go and openai-compatible default to chat-completions.
# THREADLINE_PROVIDER_API=chat-completions
# Custom providers require a base URL. It now controls the actual request target.
# THREADLINE_PROVIDER_BASE_URL=https://your-provider.example/v1

# Opt-in live test variables (separate verification stores; never model calls):
# THREADLINE_LIVE=1
# THREADLINE_LIVE_PGPORT=55434
# THREADLINE_LIVE_PGDATABASE=threadline_agent_b
# THREADLINE_LIVE_PGUSER=threadline_app
# THREADLINE_LIVE_PGPASSWORD=
# THREADLINE_LIVE_PGMIGRATIONUSER=threadline
# THREADLINE_LIVE_PGMIGRATIONPASSWORD=
# THREADLINE_LIVE_GRAPHPORT=56381
