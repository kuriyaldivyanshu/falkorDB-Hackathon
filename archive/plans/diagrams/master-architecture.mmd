  sandbox --> builder
  sandbox --> checks
  own --> capture
  tools --> capture
  capture --> pg
  capture --> objects
  pg -.-> ingester
  ingester --> ledger
  ledger --> graphDb
  graphDb -.-> projector
  projector --> pg
  projector --> api
  projector --> context
  verifier --> ledger
  checks --> verifier
  verifier --> objects
  scheduler -.-> native
  native -.-> capture
  native -.-> nativeAuth
  providers --> apiModels
