erDiagram
    direction LR
    users {
        uuid id PK
        text display_name
        text status
        timestamptz created_at
    }
    auth_identities {
        uuid id PK
        uuid user_id FK
        text issuer
        text subject
        timestamptz created_at
    }
    tenants {
        uuid id PK
        text slug
        text name
        text status
        timestamptz created_at
    }
    tenant_memberships {
        uuid tenant_id FK
        uuid id PK
        uuid user_id FK
        text role
        text status
        timestamptz created_at
    }
    projects {
        uuid tenant_id FK
        uuid id PK
        text slug
        text graph_key
        uuid graph_epoch
        text status
        integer schema_version
        timestamptz created_at
    }
    project_memberships {
        uuid tenant_id FK
        uuid project_id FK
        uuid id PK
        uuid user_id FK
        text role
        text status
        timestamptz created_at
    }
    user_sessions {
        uuid tenant_id FK
        uuid id PK
        uuid user_id FK
        char token_hash
        text auth_method
        timestamptz created_at
        timestamptz last_seen_at
        timestamptz expires_at
        timestamptz idle_expires_at
        timestamptz revoked_at
        text client_label
    }
    audit_events {
        uuid tenant_id FK
        uuid id PK
        uuid actor_user_id FK
        text kind
        uuid target_id
        uuid request_id
        jsonb payload
        timestamptz created_at
    }
    users ||--o{ auth_identities : "references"
    tenants ||--o{ tenant_memberships : "tenant_id"
    users ||--o{ tenant_memberships : "references"
    tenants ||--o{ projects : "tenant_id"
    tenant_memberships ||--o{ project_memberships : "user_id"
    projects ||--o{ project_memberships : "project_id"
    tenant_memberships ||--o{ user_sessions : "user_id"
    tenants ||--o{ user_sessions : "tenant_id"
    tenant_memberships o|--o{ audit_events : "actor_user_id"
    tenants ||--o{ audit_events : "tenant_id"
